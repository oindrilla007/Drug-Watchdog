# Copy this file to .env and fill in your own values. Never commit .env.

# ── Supabase (auth + patient data) ────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ── LLM providers (router falls back in this order) ───────────────────────────
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── Evidence sources ──────────────────────────────────────────────────────────
NCBI_API_KEY=            # optional, raises PubMed rate limits
DATABASE_URL=postgresql://postgres:watchdog@localhost:5432/drugwatchdog

# ── API security ──────────────────────────────────────────────────────────────
# Comma-separated list of frontend URLs allowed to call the API from a browser.
ALLOWED_ORIGINS=http://localhost:3000

# ── Alert delivery (optional) ─────────────────────────────────────────────────
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_FROM=
ALERT_WEBHOOK_URL=
PHARMACIST_EMAILS=
PHYSICIAN_EMAILS=

# ── Frontend (frontend/.env.local) ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
